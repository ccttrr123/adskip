<?xml version="1.0" encoding="utf-8"?>
<!--
    日志区底部渐隐：最后一行滚到底时柔和淡出，而不是被裁掉一截。
    颜色与日志区背景（colorSurfaceContainerLow）一致，深色见 drawable-night 版本。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:endColor="#FFF2F4F8"
        android:startColor="#00F2F4F8"
        android:type="linear" />
</shape>
