<?xml version="1.0" encoding="utf-8"?>
<!--
    顶部渐隐遮罩（高度见布局里的 topFade）。

    纯线性渐变：顶部不透明 → 底部全透明，**没有实心段**。
    顶部之所以要保持不透明，是为了让状态栏的时间和信号压在干净底色上；
    越往下越透明，内容滚上来时就柔和消失。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#00F7F8FB"
        android:startColor="#FFF7F8FB"
        android:type="linear" />
</shape>